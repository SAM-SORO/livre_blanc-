flowchart LR
  subgraph Poste["Poste de l'utilisateur"]
    NAV["Navigateur<br/>(mobile ou ordinateur)"]
  end
  subgraph Hote["Machine hôte — Docker Compose (déploiement local)"]
    direction LR
    subgraph APP["Conteneur app — Nuxt 4 (Node 24)"]
      direction TB
      VUE["Interface Vue<br/>rendu serveur + hydratation"]
      API["Routes serveur Nitro<br/>/api/v1"]
      MOD["Modules métier<br/>server/modules/*"]
      VUE --- API --- MOD
