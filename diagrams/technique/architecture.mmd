    end
    PG[("PostgreSQL 18<br/>données + file pg-boss")]
    FS[["Volume fichiers<br/>photos, PV, exports"]]
    MAIL["Mailpit<br/>SMTP de test + boîte web"]
  end
  NAV -- "HTTPS (local : HTTP)<br/>cookie de session scellé" --> APP
  MOD -- "SQL (Drizzle)" --> PG
